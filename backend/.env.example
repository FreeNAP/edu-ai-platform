# 复制为 backend/.env 后按需修改；也可直接用同名环境变量覆盖

# ---- 运行环境 ----
APP_ENV=development            # development / production
# DEMO_MODE=true               # 写入演示数据、登录页显示演示账号；默认开发开启、生产关闭
LOG_LEVEL=INFO
LOG_JSON=false                 # 生产建议 true，便于日志平台采集
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---- 安全（生产必须修改）----
# python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=8

# ---- 数据库（留空为 SQLite）----
# DATABASE_URL=postgresql+psycopg2://edu:password@127.0.0.1:5432/edu_platform
# DATABASE_URL=mysql+pymysql://edu:password@127.0.0.1:3306/edu_platform?charset=utf8mb4
DATABASE_URL=

# ---- 文件上传 ----
# UPLOAD_DIR=./uploads
MAX_IMAGE_MB=5
MAX_DOCUMENT_MB=10
MAX_VIDEO_MB=500

# ---- 邮件（找回密码验证码）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true

# ---- 大模型（OpenAI 兼容接口；留空使用内置引擎）----
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=30
AI_DAILY_QUOTA=100             # 学生每日 AI 调用次数，0 为不限
