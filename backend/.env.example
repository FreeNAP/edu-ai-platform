# 复制为系统环境变量使用（后端通过 os.getenv 读取）

# JWT 签名密钥，生产环境必须改成随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-string

# 数据库，默认 SQLite（backend/edu_platform.db）；MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/edu_platform?charset=utf8mb4
DATABASE_URL=

# 大模型（OpenAI 兼容接口）。留空时使用内置模拟引擎，所有 AI 功能照常可用
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
