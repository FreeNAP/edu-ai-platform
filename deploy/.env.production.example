# 生产环境配置（docker compose 使用）。复制为 deploy/.env.production 并修改
APP_ENV=production
LOG_JSON=true
# 必填：至少 32 位随机字符串 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
PUBLIC_BASE_URL=https://edu.example.com
CORS_ORIGINS=https://edu.example.com
WEB_WORKERS=2

# 邮件（找回密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true

# 大模型（留空使用内置引擎）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_DAILY_QUOTA=100
